generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id                        Int             @id @default(autoincrement())
  problem_id                String          @unique
  problem_name              String
  company_tags              String[]
  leetcode_link             String?
  gfg_link                  String?
  code360_link              String?
  tuf_article               String?
  tuf_yt_video_link         String?
  difficulty                Int?
  leetcode_premium_question Boolean         @default(false)
  tuf_link                  String?
  sheetQuestions            SheetQuestion[]
  userProgresses            UserProgress[]

  @@map("questions")
}

model Sheet {
  id                  Int             @id @default(autoincrement())
  name                String          @unique
  number_of_questions Int
  has_sub_steps       Boolean         @default(false)
  sheetQuestions      SheetQuestion[]

  @@map("sheets")
}

model SheetQuestion {
  id              Int      @id @default(autoincrement())
  question_id     Int
  sheet_id        Int
  step_number     Int
  sub_step_number Int      @default(0)
  question        Question @relation(fields: [question_id], references: [id])
  sheet           Sheet    @relation(fields: [sheet_id], references: [id])

  @@unique([question_id, sheet_id, step_number, sub_step_number])
  @@map("sheet_questions")
}

model User {
  id             Int            @id @default(autoincrement())
  first_name     String
  last_name      String
  email          String         @unique
  password_hash  String
  role           UserRole       @default(USER)
  created_at     DateTime       @default(now())
  userProgresses UserProgress[]

  @@map("users")
}

model UserProgress {
  id            Int      @id @default(autoincrement())
  user_id       Int
  question_id   Int
  done          Boolean  @default(false)
  note          String?
  leetcode_done Boolean  @default(false)
  gfg_done      Boolean  @default(false)
  code360_done  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  question      Question @relation(fields: [question_id], references: [id])
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@map("user_progress")
}

enum UserRole {
  ADMIN
  USER
}
